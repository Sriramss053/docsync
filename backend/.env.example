# Flask / Security
SECRET_KEY=change-this-super-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key
ENCRYPTION_KEY=

# Database - defaults to local SQLite if not set
DATABASE_URL=sqlite:///docsync.db
# For Postgres: postgresql://user:password@localhost:5432/docsync

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# AWS S3 (optional - falls back to local disk storage if not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
